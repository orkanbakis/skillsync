{
  "name": "skillsync",
  "version": "0.1.0",
  "description": "Author an agent skill once, sync it to every agent CLI",
  "type": "module",
  "bin": {
    "skillsync": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["cli", "agent", "skills", "claude", "codex"],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.82.0",
    "@inquirer/prompts": "8.3.2",
    "@napi-rs/keyring": "1.2.0",
    "commander": "14.0.3",
    "diff": "8.0.4",
    "openai": "6.33.0",
    "picocolors": "1.1.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.5.2",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.2"
  }
}
